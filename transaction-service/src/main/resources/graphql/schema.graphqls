type Transaction {
    id: ID!
    accountId: ID!
    amount: Float
    currency: String
    merchantCategory: String
    country: String
    createdAt: String
}

input TransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
}

type Mutation {
    createTransaction(input: TransactionInput!): Transaction
}